# Default command overrides {{{

cmd paste-shell %{{
	set -f
	load=$(cat ~/.local/share/lf/files)
	mode=$(echo "$load" | head -n+1)
	files=$(echo "$load" | tail -n+2)

	flags=()
	if [ ! -z "$@" ] && [ "$1" = '--overwrite' ]; then
		flags+=(--update=all)
	else
		flags+=(--backup=numbered)
	fi

	if [ "$mode" = 'copy' ]; then
		cp -a "${flags[@]}" $files .
	elif [ "$mode" = 'move' ]; then
		mv "${flags[@]}" $files .
		rm ~/.local/share/lf/files
		lf -remote 'send clear'
	fi
}}

