# https://github.com/gokcehan/lf/wiki/Integrations {{{

# https://github.com/gokcehan/lf/wiki/Integrations#gio-trash

cmd trash ${{
	set -f
	if gio trash 2>/dev/null; then
		gio trash $fx
	fi
}}

cmd trash-restore %{{
	set -f
	ft=$(basename -a -- $fx | sed 's|^|trash:///|')
	gio trash --restore $ft
	printf 'restored'
	printf ' %s' $(basename -a -- $fx)
}}

cmd bulkrename $set -f; vidir -- $fx
cmd chmod %set -f; chmod "$@" -- $fx
cmd mkdir %IFS=" "; mkdir -p -- "$*"
cmd suspend $kill -STOP "$PPID"
cmd inspect $LESSOPEN='| ~/.config/lf/scope-lf-wrapper.sh %s' less -R "$f"
cmd drag-and-drop &dragon $fx
cmd disk-usage !du -chs --apparent-size -- $fx | sort -h
cmd disk-usage-recursive !du -ch --apparent-size -- $fx | sort -h

