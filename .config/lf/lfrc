# Yank file names
cmd yank-paths &printf '%s' $fx | xclip -i -selection clipboard
cmd yank-dirname &printf '%s' "$PWD" | xclip -i -selection clipboard
cmd yank-basename &basename -a -- $fx | xclip -i -selection clipboard
cmd yank-basename-without-extension &basename -a -- $fx | cut -d. -f1 | xclip -i -selection clipboard

cmd extract ${{
	set -f
	for file in $fx; do
		case "$file" in
			*.tar.bz|*.tar.bz2|*.tbz|*.tbz2) tar xjvf "$file";;
			*.tar.gz|*.tgz) tar xzvf "$file";;
			*.tar.xz|*.txz) tar xJvf "$file";;
			*.zip) unzip "$file";;
			*.rar) unrar x "$file";;
			*.7z) 7z x "$file";;
			*) lf -remote "send $id echoerr \"Could not find extractor for archive format.\"";;
		esac
	done
}}

cmd compress ${{
	set -f
	ARCHIVE="$@"
	COMPRESS_DIR="$(basename -a -- "$ARCHIVE" | cut -d. -f1)"

	pre() {
		mkdir "$COMPRESS_DIR"
		cp -ra $fx "$COMPRESS_DIR"
	}
	post() {
		rm -rf "$COMPRESS_DIR"
	}

	case "$ARCHIVE" in
		*.tar.bz|*.tar.bz2|*.tbz|*.tbz2) pre; tar cjvf "$ARCHIVE" "$COMPRESS_DIR"; post;;
		*.tar.gz|*.tgz) pre; tar czvf "$ARCHIVE" "$COMPRESS_DIR"; post;;
		*.tar.xz|*.txz) pre; tar cJvf "$ARCHIVE" "$COMPRESS_DIR"; post;;
		*.zip) pre; zip "$ARCHIVE" "$COMPRESS_DIR"; post;;
		*.7z) pre; 7z a "$ARCHIVE" "$COMPRESS_DIR"; post;;
		*) lf -remote "send $id echoerr \"Could not find compressor for archive format\""; exit;;
	esac
}}

