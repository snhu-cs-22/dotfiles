# https://github.com/gokcehan/lf/wiki/Ranger
# File opener (Rifle)
cmd open $set -f; rifle -p 0 $fx
cmd open-with ${{
	clear
	set -f
	rifle -l $fx | sed -e "s/:[a-Z]*:[a-Z]*:/ \| /"
	read -p "open with: " method
	rifle -p $method $fx
}}
cmd open-with-gui &"$@" $fx # opens asynchronously, intended for GUI applications
cmd open-with-tui $"$@" $fx # opens synchronously, intended for TUI applications
cmd open-with-cli %"$@" $fx # opens synchronously and prints to the bottom statline, intended for CLI applications

# https://github.com/gokcehan/lf/wiki/Tips {{{

# Use environment variables in command or mapping
cmd eval &{{
	cmd="send $id"
	for arg; do
		cmd="$cmd $(eval "printf '%s' \"$arg\"" | sed 's/\\/\\\\/g;s/ /\\ /g;s/"/\\"/g')"
	done
	lf -remote "$cmd"
}}

cmd follow-link %{{
	lf -remote "send $id select \"$(readlink -- "$f" | sed 's/\\/\\\\/g;s/"/\\"/g')\""
}}

cmd paste-link %{{
	set -f
	files=$(cat ~/.local/share/lf/files | tail -n+2)
	if [ -z "$@" ]; then
		ln -si $files . && exit
	fi
	case "$1" in
		--relative) ln -sir $files .;;
		--hard) ln -i $files .;;
		*) lf -remote "send $id echoerr \"Invalid flag: $1\"";;
	esac
}}

cmd glob-select-recursive &{{
	select_glob() {
		files=$(printf '%s\0' "$@" | sed 's/ /\\ /g;s/\x00/ /g')
		lf -remote "send $id :unselect; toggle $files"
	}

	[ "$#" -eq 1 ] || exit

	# enable recursive glob, failglob, and extended glob
	shopt -s globstar failglob extglob

	select_glob $1
}}

cmd fuzzy-select ${{
	file=$(fzf --prompt='Select file: ')
	$lf -remote "send $id select \"$file\""
}}

cmd fuzzy-cd ${{
	dir=$(fzf \
		--prompt='Select dir to cd to: ' \
		--walker=dir,hidden,follow
	)
	$lf -remote "send $id cd \"$dir\""
}}

cmd fuzzy-history-search ${{
	cmd=$(
		lf -remote "query $id history" |
		awk -F'\t' 'NR > 1 { print $NF }' |
		sort -u |
		fzf --prompt='Execute command: '
	)
	lf -remote "send $id push ${cmd//\ /<space>}"
}}

