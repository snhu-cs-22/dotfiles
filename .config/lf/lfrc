# Jumping around
cmd move-parent &{{
	dironly="setlocal \"$(dirname -- "$PWD" | sed 's/\\/\\\\/g;s/"/\\"/g')\" dironly"
	lf -remote "send $id :updir; $dironly true; $1; $dironly false; open"
}}

# Adding/removing from clipboard {{{

cmd clipboard-add %{{
	case "$1" in
		--copy) sed -i '1s/.*/copy/' ~/.local/share/lf/files;;
		--cut) sed -i '1s/.*/move/' ~/.local/share/lf/files;;
		*) lf -remote "send $id echoerr \"Invalid flag: $1\"" && exit 1;;
	esac
	printf '%s\n' $fx >> ~/.local/share/lf/files
	lf -remote "send $id :unselect; sync"
}}

cmd clipboard-remove %{{
	case "$1" in
		--copy) sed -i '1s/.*/copy/' ~/.local/share/lf/files;;
		--cut) sed -i '1s/.*/move/' ~/.local/share/lf/files;;
		*) lf -remote "send $id echoerr \"Invalid flag: $1\"" && exit 1;;
	esac
	printf '%s\n' $fx | while IFS= read -r file; do
		sed -i "\|^$file$|d" ~/.local/share/lf/files
	done
	lf -remote "send $id :unselect; sync"
}}

cmd clipboard-toggle %{{
	files=$(comm --output-delimiter= -3 \
		<(tail -n+2 ~/.local/share/lf/files | sort) \
		<(printf '%s\n' $fx | sort) | tr -d '\0')
	case "$1" in
		--copy) printf 'copy\n%s\n' $files > ~/.local/share/lf/files;;
		--cut) printf 'move\n%s\n' $files > ~/.local/share/lf/files;;
		*) lf -remote "send $id echoerr \"Invalid flag: $1\"" && exit 1;;
	esac
	lf -remote "send $id :unselect; sync"
}}

