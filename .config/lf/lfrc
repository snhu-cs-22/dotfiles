# Commands {{{

# Hook commands {{{

cmd on-load &{{
	cd "$(dirname "$1")" || exit 1
	[ "$(git rev-parse --is-inside-git-dir 2>/dev/null)" = false ] || exit 0

	cmds=""

	for file in "$@"; do
		case "$file" in
			*/.git|*/.git/*) continue;;
		esac

		status=$(git status --porcelain --ignored -- "$file" | cut -c1-2 | head -n1)

		if [ -n "$status" ]; then
			cmds="${cmds}addcustominfo '$file' '$status'; "
		else
			cmds="${cmds}addcustominfo '$file' ''; "
		fi
	done

	lf -remote "send $id :$cmds"
}}

cmd on-cd &{{
	# Set the terminal title to the current directory
	printf '\033]0;lf - %s\007' "${PWD/#$HOME/\~}" > /dev/tty
	# display git repository status in your prompt
	source /etc/bash_completion.d/git-prompt
	GIT_PS1_SHOWDIRTYSTATE=auto
	GIT_PS1_SHOWSTASHSTATE=auto
	GIT_PS1_SHOWUNTRACKEDFILES=auto
	GIT_PS1_SHOWUPSTREAM=auto
	GIT_PS1_COMPRESSSPARSESTATE=auto
	GIT_PS1_SHOWCONFLICTSTATE=auto
	GIT_PS1_DESCRIBE_STYLE='branch'
	git="$(__git_ps1 " (%s)")" || true
	fmt="\033[32;1m%u@%h\033[0m:\033[34;1m%w\033[0m$git\033[0m"
	lf -remote "send $id set promptfmt \"$fmt\""
}}

# https://konfekt.github.io/blog/2024/09/15/lf-linux-windows {{{

# Adjust pane ratios on window resize
cmd on-redraw %{{
	widths=(0 80 160)
	if [ "$lf_preview" = true ]; then
		ratios=("1:2" "1:3:2" "1:2:5:3")
	else
		ratios=("1" "1:5" "1:2:8")
	fi

	ratio=""
	for ((i=0;i<${#widths[@]};i++)); do
		if [ "$lf_width" -ge ${widths[i]} ]; then
			ratio=${ratios[i]}
		fi
	done

	lf -remote "send $id set ratios $ratio"
}}

# Unset pane_path when quitting
cmd on-quit &printf '\033]7;\033\\' > /dev/tty

